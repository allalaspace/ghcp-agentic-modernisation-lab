    {
      "id": "cwe-injection-attacks::b286f85962ef",
      "title": "Deserialization of Untrusted Data",
      "category": "cwe-injection-attacks",
      "severity": "mandatory",
      "description": "OrderController.create deserializes the untrusted request body directly into Order (line 49). Validation checks customer and amount only, while Order exposes a client-settable id (Order.java:63); OrderService.create passes it to repository.save (line 37). A non-null client id can cause Spring Data JPA to merge and overwrite an existing record through the create endpoint.",
      "evidence": {
        "files": [
          "src/main/java/com/contoso/demo/orderservice/model/Order.java",
          "src/main/java/com/contoso/demo/orderservice/service/OrderService.java",
          "src/main/java/com/contoso/demo/orderservice/web/OrderController.java"
        ],
        "explanation": "OrderController.create deserializes the untrusted request body directly into Order (line 49). Validation checks customer and amount only, while Order exposes a client-settable id (Order.java:63); OrderService.create passes it to repository.save (line 37). A non-null client id can cause Spring Data JPA to merge and overwrite an existing record through the create endpoint."
      },
      "storyPoint": 0
    }
